#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

PLATFORM="codex"
ARGS=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --platform)
      PLATFORM="$2"
      shift 2
      ;;
    *)
      ARGS+=("$1")
      shift
      ;;
  esac
done

if [[ ${#ARGS[@]} -gt 0 ]]; then
  exec python3 "$REPO_ROOT/.ai/tools/session_init.py" --platform "$PLATFORM" "${ARGS[@]}"
else
  exec python3 "$REPO_ROOT/.ai/tools/session_init.py" --platform "$PLATFORM"
fi
