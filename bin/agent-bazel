#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

source "$SCRIPT_DIR/_agent_common.sh"

usage() {
  cat <<'EOF'
Usage: bin/agent-bazel <build|test|run|clean|query>

Subcommands:
  build   Build targets with Bazel
  test    Run Bazel test suite
  run     Execute Bazel target
  clean   Clean Bazel build artefacts
  query   Query Bazel build graph

Examples:
  bin/agent-bazel build
  bin/agent-bazel build //src/kernels:flash_attention
  bin/agent-bazel build --config=cuda //...
EOF
}

check_bazel_workspace() {
  if [[ ! -f "$REPO_ROOT/WORKSPACE" ]] && [[ ! -f "$REPO_ROOT/WORKSPACE.bazel" ]] && [[ ! -f "$REPO_ROOT/MODULE.bazel" ]]; then
    echo "Error: No WORKSPACE, WORKSPACE.bazel, or MODULE.bazel file found in $REPO_ROOT" >&2
    echo "This does not appear to be a Bazel workspace." >&2
    exit 1
  fi
}

detect_bazel_bin() {
  if command -v bazel >/dev/null 2>&1; then
    echo "bazel"
    return 0
  fi

  if command -v bazelisk >/dev/null 2>&1; then
    echo "bazelisk"
    return 0
  fi

  return 1
}

check_bazel_installed() {
  if ! BAZEL_BIN="$(detect_bazel_bin)"; then
    echo "Error: bazel command not found" >&2
    echo "" >&2
    echo "Install Bazel:" >&2
    echo "  - Bazelisk (recommended): https://github.com/bazelbuild/bazelisk" >&2
    echo "  - Bazel: https://bazel.build/install" >&2
    exit 1
  fi
}

prepare_bazel_env() {
  check_bazel_workspace
  check_bazel_installed

  # Set CUDA environment variables if available.
  if [[ -n "${CUDA_HOME:-}" ]]; then
    export CUDA_HOME
    echo "Using CUDA_HOME=$CUDA_HOME"
  fi

  if [[ -n "${CUDNN_ROOT:-}" ]]; then
    export CUDNN_ROOT
    echo "Using CUDNN_ROOT=$CUDNN_ROOT"
  fi

  if [[ -n "${NCCL_ROOT:-}" ]]; then
    export NCCL_ROOT
    echo "Using NCCL_ROOT=$NCCL_ROOT"
  fi
}

bazel_build() {
  prepare_bazel_env

  if [[ $# -eq 0 ]]; then
    set -- "//..."
  fi

  echo "Running: $BAZEL_BIN build $*"
  (cd "$REPO_ROOT" && "$BAZEL_BIN" build "$@")
}

bazel_test() {
  prepare_bazel_env

  if [[ $# -eq 0 ]]; then
    set -- "//..."
  fi

  echo "Running: $BAZEL_BIN test $*"
  (cd "$REPO_ROOT" && "$BAZEL_BIN" test "$@")
}

bazel_run() {
  prepare_bazel_env

  if [[ $# -eq 0 ]]; then
    echo "Error: bin/agent-bazel run requires a target" >&2
    exit 1
  fi

  echo "Running: $BAZEL_BIN run $*"
  (cd "$REPO_ROOT" && "$BAZEL_BIN" run "$@")
}

bazel_clean() {
  prepare_bazel_env

  echo "Running: $BAZEL_BIN clean $*"
  (cd "$REPO_ROOT" && "$BAZEL_BIN" clean "$@")
}

bazel_query() {
  prepare_bazel_env

  if [[ $# -eq 0 ]]; then
    echo "Error: bin/agent-bazel query requires a query expression" >&2
    exit 1
  fi

  echo "Running: $BAZEL_BIN query $*"
  (cd "$REPO_ROOT" && "$BAZEL_BIN" query "$@")
}

main() {
  if [[ $# -eq 0 ]]; then
    usage
    exit 1
  fi

  local subcommand="$1"
  shift

  case "$subcommand" in
    build)
      bazel_build "$@"
      ;;
    test)
      bazel_test "$@"
      ;;
    run)
      bazel_run "$@"
      ;;
    clean)
      bazel_clean "$@"
      ;;
    query)
      bazel_query "$@"
      ;;
    -h|--help|help)
      usage
      exit 0
      ;;
    *)
      echo "Error: Unknown subcommand: $subcommand" >&2
      echo "" >&2
      usage
      exit 1
      ;;
  esac
}

main "$@"
