#!/usr/bin/env bash
set -euo pipefail

if [[ $# -lt 1 ]]; then
  echo "Usage: bin/agent-roadmap <check|create|status|update|handoff|complete|validate> [args]" >&2
  exit 1
fi

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
ROADMAP_SCRIPTS="$REPO_ROOT/.claude/skills/roadmap/scripts"

command="$1"
shift || true

case "$command" in
  check)
    exec python3 "$ROADMAP_SCRIPTS/check.py" "$@"
    ;;
  create)
    exec python3 "$ROADMAP_SCRIPTS/create.py" "$@"
    ;;
  status)
    exec python3 "$ROADMAP_SCRIPTS/status.py" "$@"
    ;;
  update)
    exec python3 "$ROADMAP_SCRIPTS/update.py" "$@"
    ;;
  handoff)
    exec python3 "$ROADMAP_SCRIPTS/handoff.py" "$@"
    ;;
  complete)
    exec python3 "$ROADMAP_SCRIPTS/complete.py" "$@"
    ;;
  validate)
    exec python3 "$ROADMAP_SCRIPTS/validate_schema.py" "$@"
    ;;
  *)
    echo "Unknown roadmap command: $command" >&2
    echo "Supported: check, create, status, update, handoff, complete, validate" >&2
    exit 1
    ;;
esac
