#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

source "$SCRIPT_DIR/_agent_common.sh"

usage() {
  cat <<'EOF'
Usage: bin/agent-build <setup|compile|test|full|doctor|clean>
EOF
}

get_build_system() {
  # Try reading project_profile.build_system from .ai/project.yml
  if [[ -f "$REPO_ROOT/.ai/project.yml" ]]; then
    # Try new project_profile format first
    local build_system
    build_system=$(awk '
      /^project_profile:/ { in_profile=1; next }
      in_profile && /^  build_system:/ { sub(/^  build_system: */, ""); print; exit }
      in_profile && /^[^ ]/ { exit }
    ' "$REPO_ROOT/.ai/project.yml")

    if [[ -n "$build_system" ]]; then
      echo "$build_system"
      return
    fi

    # Fall back to legacy project_type and map to build_system
    local project_type
    project_type=$(awk -F': *' '/^project_type:/ {print $2; exit}' "$REPO_ROOT/.ai/project.yml")

    case "$project_type" in
      python) echo "poetry" ;;
      cpp) echo "cmake" ;;
      *) echo "poetry" ;;  # Default fallback
    esac
    return
  fi

  # No config file, default to poetry
  echo "poetry"
}

poetry_setup() {
  if has_poetry_project "$REPO_ROOT"; then
    (cd "$REPO_ROOT" && poetry install)
    return
  fi

  echo "No Poetry project detected. Add pyproject.toml before using build setup for Python." >&2
  exit 1
}

poetry_compile() {
  echo "Poetry projects do not have a separate compile step. Use 'test' or 'doctor' instead."
}

poetry_test() {
  if has_poetry_project "$REPO_ROOT"; then
    (cd "$REPO_ROOT" && poetry run pytest)
    return
  fi

  echo "No Poetry project detected. Add pyproject.toml before using build test for Python." >&2
  exit 1
}

poetry_doctor() {
  if has_poetry_project "$REPO_ROOT"; then
    (cd "$REPO_ROOT" && poetry env info)
  else
    echo "No Poetry project detected. Python environment doctor is limited."
  fi

  echo "Run 'bin/agent-python-env-setup diagnose' for deeper environment checks."
}

cmake_setup() {
  if [[ -f "$REPO_ROOT/conanfile.txt" || -f "$REPO_ROOT/conanfile.py" ]]; then
    (cd "$REPO_ROOT" && conan install . --build=missing -of build)
  fi
  (cd "$REPO_ROOT" && cmake -S . -B build)
}

cmake_compile() {
  (cd "$REPO_ROOT" && cmake --build build)
}

cmake_test() {
  (cd "$REPO_ROOT" && ctest --test-dir build --output-on-failure)
}

cmake_doctor() {
  (cd "$REPO_ROOT" && cmake --version)
  if command -v conan >/dev/null 2>&1; then
    conan --version
  fi
  if [[ -d "$REPO_ROOT/build" ]]; then
    echo "Build directory present: $REPO_ROOT/build"
  else
    echo "Build directory missing. Run 'bin/agent-build setup' first."
  fi
}

cmake_clean() {
  rm -rf "$REPO_ROOT/build"
  echo "Removed build directory."
}

scikit_build_setup() {
  if [[ ! -f "$REPO_ROOT/pyproject.toml" ]]; then
    echo "No pyproject.toml found. scikit-build-core requires pyproject.toml." >&2
    exit 1
  fi

  # Install in editable mode with scikit-build-core
  (cd "$REPO_ROOT" && pip install -e . --no-build-isolation)
}

scikit_build_compile() {
  echo "scikit-build-core handles compilation during pip install."
  echo "Run 'bin/agent-build setup' to trigger a rebuild."
}

scikit_build_test() {
  if [[ -f "$REPO_ROOT/pyproject.toml" ]]; then
    (cd "$REPO_ROOT" && python -m pytest)
    return
  fi

  echo "No pyproject.toml detected." >&2
  exit 1
}

scikit_build_doctor() {
  echo "=== scikit-build-core Environment ==="
  python --version
  pip show scikit-build-core 2>/dev/null || echo "scikit-build-core not installed"
  pip show nanobind 2>/dev/null || echo "nanobind not installed"

  if command -v cmake >/dev/null 2>&1; then
    cmake --version | head -1
  else
    echo "cmake not found"
  fi

  if command -v nvcc >/dev/null 2>&1; then
    nvcc --version | grep "release"
  else
    echo "CUDA not found"
  fi
}

scikit_build_clean() {
  rm -rf "$REPO_ROOT/build" "$REPO_ROOT/_skbuild" "$REPO_ROOT/dist" "$REPO_ROOT"/*.egg-info
  echo "Removed build artifacts (build/, _skbuild/, dist/, *.egg-info)."
}

bazel_setup() {
  "$SCRIPT_DIR/agent-bazel" query //... >/dev/null
  echo "Bazel workspace and toolchain checks passed."
}

bazel_compile() {
  "$SCRIPT_DIR/agent-bazel" build //...
}

bazel_test() {
  "$SCRIPT_DIR/agent-bazel" test //...
}

bazel_doctor() {
  if command -v bazel >/dev/null 2>&1; then
    bazel --version
  elif command -v bazelisk >/dev/null 2>&1; then
    bazelisk --version
  else
    echo "bazel not found"
    return 1
  fi

  if [[ -f "$REPO_ROOT/WORKSPACE" || -f "$REPO_ROOT/WORKSPACE.bazel" || -f "$REPO_ROOT/MODULE.bazel" ]]; then
    echo "Bazel workspace detected."
  else
    echo "Bazel workspace not detected."
    return 1
  fi
}

bazel_clean() {
  "$SCRIPT_DIR/agent-bazel" clean
}

mixed_stub() {
  cat >&2 <<'EOF'
Mixed build system support is not yet implemented in this phase.

This build system configuration will be fully supported in Phase 2 of the
AI Infra Optimisation roadmap. For now, you can:
- Use Poetry for pure Python projects
- Use CMake for pure C++/CUDA projects

See .ai/adr/0001-project-profile.md for the roadmap.
EOF
  exit 1
}

main() {
  local command="${1:-}"
  if [[ -z "$command" ]]; then
    usage
    exit 1
  fi

  case "$(get_build_system)" in
    poetry)
      case "$command" in
        setup) poetry_setup ;;
        compile) poetry_compile ;;
        test) poetry_test ;;
        full) poetry_setup; poetry_test ;;
        doctor) poetry_doctor ;;
        clean) echo "No standard clean step for Poetry projects." ;;
        *) usage; exit 1 ;;
      esac
      ;;
    cmake)
      case "$command" in
        setup) cmake_setup ;;
        compile) cmake_compile ;;
        test) cmake_test ;;
        full) cmake_setup; cmake_compile; cmake_test ;;
        doctor) cmake_doctor ;;
        clean) cmake_clean ;;
        *) usage; exit 1 ;;
      esac
      ;;
    scikit-build|scikit-build-core)
      case "$command" in
        setup) scikit_build_setup ;;
        compile) scikit_build_compile ;;
        test) scikit_build_test ;;
        full) scikit_build_setup; scikit_build_test ;;
        doctor) scikit_build_doctor ;;
        clean) scikit_build_clean ;;
        *) usage; exit 1 ;;
      esac
      ;;
    bazel)
      case "$command" in
        setup) bazel_setup ;;
        compile) bazel_compile ;;
        test) bazel_test ;;
        full) bazel_compile; bazel_test ;;
        doctor) bazel_doctor ;;
        clean) bazel_clean ;;
        *) usage; exit 1 ;;
      esac
      ;;
    mixed)
      mixed_stub
      ;;
    *)
      echo "Unsupported or unknown build system: $(get_build_system)" >&2
      exit 1
      ;;
  esac
}

main "$@"
