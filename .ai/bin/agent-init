#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=/dev/null
source "$SCRIPT_DIR/_agent_common.sh"
REPO_ROOT="$(agent_repo_root)"

PLATFORM="codex"
ARGS=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --platform)
      PLATFORM="$2"
      shift 2
      ;;
    *)
      ARGS+=("$1")
      shift
      ;;
  esac
done

if [[ ${#ARGS[@]} -gt 0 ]]; then
  run_agent_python "$REPO_ROOT" "$REPO_ROOT/.ai/scripts/session_init.py" --platform "$PLATFORM" "${ARGS[@]}"
else
  run_agent_python "$REPO_ROOT" "$REPO_ROOT/.ai/scripts/session_init.py" --platform "$PLATFORM"
fi
