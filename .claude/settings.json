{
  "permissions": {
    "allow": [
      "Bash(source:*)",
      "Bash(python -m pytest:*)",
      "Bash(python3 -m pytest:*)",
      "Bash(python3 .ai/scripts/**)",
      "Bash(python3 .claude/skills/**)",
      "Bash(bin/agent-init:*)",
      "Bash(bin/agent-build:*)",
      "Bash(bin/agent-precommit:*)",
      "Bash(bin/agent-dependency:*)",
      "Bash(bin/agent-python-env-setup:*)",
      "Bash(bin/agent-check-constraints:*)",
      "Bash(bin/agent-commit:*)",
      "Bash(tree:*)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(wc:*)",
      "Bash(grep:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git branch:*)",
      "Bash(git show:*)",
      "Read(**)",
      "LS(**)",
      "Tree(**)",
      "Grep(**)",
      "Glob(**)",
      "WebFetch",
      "WebSearch",
      "MCP"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/pre_tool_use.sh"
          }
        ]
      }
    ]
  }
}
