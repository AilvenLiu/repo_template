#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

source "$SCRIPT_DIR/_agent_common.sh"
REPO_ROOT="$(agent_repo_root)"

usage() {
  cat <<'EOF'
Usage: .agents/bin/agent-python-env-setup <diagnose|fix|verify> [extra args]
EOF
}

main() {
  local command="${1:-}"
  shift || true

  # Poetry sets VIRTUAL_ENV for its child process. Preserve whether the caller
  # had an externally activated environment so Python checks do not mistake
  # Poetry's own venv for a shell-configuration fault.
  if [[ -n "${VIRTUAL_ENV:-}" ]]; then
    export AGENT_PARENT_VIRTUAL_ENV_SET=1
    export AGENT_PARENT_VIRTUAL_ENV="$VIRTUAL_ENV"
  else
    export AGENT_PARENT_VIRTUAL_ENV_SET=0
    unset AGENT_PARENT_VIRTUAL_ENV
  fi

  case "$command" in
    diagnose)
      run_agent_python "$REPO_ROOT" "$REPO_ROOT/.agents/scripts/python-env-setup/diagnose.py" "$@"
      ;;
    fix)
      run_agent_python "$REPO_ROOT" "$REPO_ROOT/.agents/scripts/python-env-setup/fix.py" "$@"
      ;;
    verify)
      run_agent_python "$REPO_ROOT" "$REPO_ROOT/.agents/scripts/python-env-setup/verify.py" "$@"
      ;;
    *)
      usage
      exit 1
      ;;
  esac
}

main "$@"
