#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=/dev/null
source "$SCRIPT_DIR/_agent_common.sh"
REPO_ROOT="$(agent_repo_root)"

if [[ $# -lt 1 ]]; then
  echo "Usage: .agents/bin/agent-dependency add <package> [version] [--dev]" >&2
  exit 1
fi

SUBCMD="$1"
shift

if [[ "$SUBCMD" != "add" ]]; then
  echo "Unsupported subcommand: $SUBCMD" >&2
  echo "Supported: add" >&2
  exit 1
fi

RAW_CMD="add $*"
run_agent_python "$REPO_ROOT" "$REPO_ROOT/.agents/scripts/policy_gate.py" --op dependency --command "$RAW_CMD"

run_agent_python "$REPO_ROOT" "$REPO_ROOT/.agents/scripts/dependency/add.py" "$@"
