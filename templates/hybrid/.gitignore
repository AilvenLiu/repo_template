.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
.hypothesis/
nosetests.xml
test-results/

# Python type checking
.mypy_cache/
.dmypy.json
dmypy.json
.pytype/
.pyre/

# Jupyter Notebook
.ipynb_checkpoints
*.ipynb_checkpoints/
profile_default/
ipython_config.py

# Cython
cython_debug/

# C++/CUDA Build directories
build/
cmake-build-*/
out/
lib/

# Compiled Object files
*.o
*.obj
*.ko
*.elf

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.so.*
*.dylib
*.dll

# Compiled Static libraries
*.a
*.lib
*.la
*.lo

# Executables
*.exe
*.out
*.app
*.i*86
*.x86_64
*.hex

# CUDA compiled files
*.cubin
*.fatbin
*.ptx

