CMakeCache.txt
CMakeFiles/
CMakeScripts/
cmake_install.cmake
install_manifest.txt
compile_commands.json
CTestTestfile.cmake
_deps/

# Ninja
.ninja_deps
.ninja_log

# C++/CUDA Testing
Testing/
*.gcov
*.gcda
*.gcno

# Coverage
coverage/
coverage.info
*.profdata
*.profraw

# Profiling
*.nvprof
*.nvvp
*.qdrep
*.qdstrm

