# Hybrid Python/C++/CUDA Project .gitignore

# Python Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
.python-version

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# Python Distribution / packaging
dist/
*.egg-info/
*.egg
.eggs/
wheels/
pip-wheel-metadata/
share/python-wheels/

